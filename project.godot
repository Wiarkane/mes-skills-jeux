; Fichier de configuration du projet Godot.

config_version=5

[application]

config/name="Roguelike"
config/description="Un roguelike au tour par tour : donjons générés, champ de vision, mort définitive."
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.5")

[display]

window/size/viewport_width=1440
window/size/viewport_height=944
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"

[rendering]

environment/defaults/default_clear_color=Color(0.05, 0.05, 0.063, 1)
textures/canvas_textures/default_texture_filter=0
